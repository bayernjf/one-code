{
  "name": "@ai-watchdog/desktop",
  "version": "0.1.0",
  "description": "AI Watchdog desktop app: cross-product monitoring daemon (Electron tray)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && cp src/renderer/settings.html dist/renderer/settings.html",
    "start": "npm run build && electron .",
    "dev": "tsc -p tsconfig.json && electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "gen:tray-icon": "node scripts/gen-tray-icon.js"
  },
  "dependencies": {
    "@ai-watchdog/core": "0.1.0",
    "chokidar": "^3.6.0",
    "node-notifier": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/node-notifier": "^8.0.5",
    "electron": "^31.0.0",
    "typescript": "^5.3.0"
  }
}
