{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ES2021",
    "lib": ["ES2021", "DOM"],
    "outDir": "dist/renderer",
    "rootDir": "src/renderer",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true
  },
  "include": ["src/renderer/**/*"]
}
